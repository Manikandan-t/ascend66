<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Day 1" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_span" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text=" / 66" android:textColor="#666666" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FF6A00" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
        android:max="1" android:progress="0" android:progressDrawable="@drawable/widget_bar" />

    <TextView android:id="@+id/w_tasks" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="0/0 tasks done" android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="#8E8E8E" android:textSize="12sp" />
</LinearLayout>
